# ------------------------------------------------------------------
# Copy to .env for local dev. On Render, add these in
# Dashboard -> your service -> Environment (never commit real values).
# ------------------------------------------------------------------

# --- required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pinkearn?retryWrites=true&w=majority
BOT_TOKEN=123456:ABC-your-botfather-token
BOT_USERNAME=shaddowearn_bot
# Your Vercel URL (comma separate for several). Also used for the bot's "Open app" button.
FRONTEND_URL=https://your-app.vercel.app

# --- admin ---
# Telegram numeric IDs that get withdrawal requests with Approve/Reject buttons
ADMIN_IDS=123456789
# 6 digits. Secret PIN for the in-app Admin Panel. Set ONLY here (Render env), never in frontend code.
ADMIN_PIN=123456
# Estimated revenue per ad (Ks) used by the admin profit calculation (editable later in Admin > Settings)
AD_REVENUE_KS=45
# Long random string for /api/admin/* (header: x-admin-key)
ADMIN_API_KEY=change-me-to-a-long-random-string
SUPPORT_USERNAME=PinkEarnSupport

# --- ads (AdsGram) ---
ADSGRAM_BLOCK_ID=
# Reward URL to enter in AdsGram:  https://<render-url>/api/ads/adsgram-reward?secret=<this value>&userid=[userId]
ADSGRAM_REWARD_SECRET=
# true = only pay after AdsGram's server callback arrived (recommended in production, needs the secret above)
REQUIRE_PROVIDER_CONFIRM=false
# true = if no AdsGram block id is set, users see a simple countdown "demo ad". Set false in production.
ALLOW_DEMO_ADS=true

# --- optional overrides (defaults shown) ---
# WEBHOOK_SECRET=            (auto-derived from BOT_TOKEN if empty)
# BACKEND_URL=               (Render sets RENDER_EXTERNAL_URL automatically)
# TZ_OFFSET_MINUTES=390      (day reset time zone, 390 = Myanmar UTC+6:30)
# PTS_PER_KS=1               (1 point = 1 Ks)
# MIN_WITHDRAW_KS=500
# WITHDRAW_METHODS=KBZ Pay,Wave Pay
# MAIN_AD_REWARD=15
# MAIN_AD_SECONDS=30
# DAILY_AD_CAP=40
# ADS_TASK_TARGET=5
# ADS_TASK_REWARD=125
# INVITE_TASK_REWARD=50
# STREAK_REWARDS=5,5,10,10,15,15,20
# REFERRAL_ACTIVATION_ADS=5
# REFERRAL_BONUS=50
# COMMISSION_RATE=0.1

# --- local testing only ---
# DEV_AUTH=true              (lets you call the API with header x-dev-user: 111 without Telegram)
PORT=3000

# ---- app name + games (all optional) ----
# APP_NAME=ShadowEarn
# GAME_AD_SECONDS=10
# GAME_COOLDOWN_MINUTES=10
# SPIN_DAILY_LIMIT=3
# SCRATCH_DAILY_LIMIT=3
# SPIN_PAID_COST=15
# MYSTERY_COST=15

# ---- piggy bank / channel (optional) ----
# PIGGY_CYCLE_SECONDS=600
# PIGGY_BASE_REWARD=2
# PIGGY_BOOST_REWARD=15
# CHANNEL_USERNAME=ShadowEarnOfficial   # channel @username (empty = banner hidden). Add the bot as a channel admin to verify joins.
# CHANNEL_REWARD=10
# MAIN_AD_DAILY_LIMIT=5
# MAIN_AD_COOLDOWN_MINUTES=5
# Optional: auto-delete history rows older than N days (saves Atlas space)
# History rows auto-delete after N days (default 30, 0 = keep forever)
TX_TTL_DAYS=30
# AdsGram: ADSGRAM_REWARD_SECRET=<long random>, REQUIRE_PROVIDER_CONFIRM=true

# Public payout-proof channel (REQUIRED by AdsGram clause 8). Add the bot as admin with "Post messages". Every approved withdrawal is posted here (name/phone masked).
# PROOF_CHANNEL=ShadowEarnProofs
